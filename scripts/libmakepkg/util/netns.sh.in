[[ -n "$LIBMAKEPKG_UTIL_NETNS_SH" ]] && return
LIBMAKEPKG_UTIL_NETNS_SH=1

MAKEPKG_LIBRARY=${MAKEPKG_LIBRARY:-'@libmakepkgdir@'}

source "$MAKEPKG_LIBRARY/util/error.sh"
source "$MAKEPKG_LIBRARY/util/message.sh"

# options handed to unshare(1) to detach a process from the network while
# keeping everything else shared
NETNS_UNSHARE_ARGS=(--user --net --map-current-user)

netns_supported() {
	type -p unshare >/dev/null || return 1
	unshare "${NETNS_UNSHARE_ARGS[@]}" -- true 2>/dev/null
}

netns_assert_supported() {
	if ! netns_supported; then
		error "$(gettext "Unable to create a network namespace for build isolation.")"
		plainerr "$(gettext "This requires unshare(1) and a kernel with unprivileged user namespaces enabled.")"
		plainerr "$(gettext "Set BUILDENV=(!netsandbox) in makepkg.conf or pass --nonetsandbox to disable isolation.")"
		exit $E_CONFIG_ERROR
	fi
}
